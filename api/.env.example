# Copy to .env for local development.
PORT=4000
# MongoDB Atlas (free M0) connection string. Leave empty locally to use an in-memory database.
MONGODB_URI=
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me
# The web app's origin (for CORS when not using the Next.js /api proxy).
WEB_ORIGIN=http://localhost:3000
# Shared with the web app (same value there). When set, the API only answers requests
# that come through the web app's /api proxy, and rate limits use the visitor's real IP.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PROXY_SECRET=
# First admin account, created once on start if it doesn't exist (password: 12+ characters).
# Production never creates the demo admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# true = also create the demo buyer/NRI/owner/agent accounts in production (shared password!)
SEED_DEMO_USERS=false

# AI assistant (all optional; without keys the assistant uses rules only)
GEMINI_API_KEY=
# Comma-separated, tried in order when one hits its free limit
GEMINI_MODELS=gemini-flash-lite-latest,gemini-flash-latest,gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Optional free fallbacks, tried in this order after Gemini
# OmniRoute (https://github.com/diegosouzapw/OmniRoute): local gateway over free providers.
# Start it, connect providers in its dashboard, copy the key from Dashboard → Endpoints.
# e.g. http://localhost:20128/v1
OMNIROUTE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODELS=auto
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Free-tier protection (defaults; admins can change them in Admin → Settings)
AI_DAILY_LIMIT=15
AI_GLOBAL_DAILY_LIMIT=800

# Per-account upload cap (photos + documents), protects the free database (defaults; editable in Admin → Settings)
UPLOAD_MAX_FILES=80
UPLOAD_MAX_MB=60
