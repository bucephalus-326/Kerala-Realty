# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# The API's address (Render URL in production)
API_URL=http://localhost:4000
# Same value as the API's PROXY_SECRET (leave empty locally if the API has none)
PROXY_SECRET=
# Public address of the site, for the sitemap and share previews (Vercel's own URL is used if empty)
NEXT_PUBLIC_SITE_URL=
# WhatsApp number with country code, digits only, e.g. 9198xxxxxxxx. WhatsApp buttons are hidden while empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Demo sign-in buttons in production: "true" (buyer, NRI, owner, agent; needs SEED_DEMO_USERS=true on the API) or empty
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=
